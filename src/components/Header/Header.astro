<header class="site-header">
    <nav class="dropdown-menu">
        <button class="menu-button">Сoffee</button>
        <button class="menu-button">Beer</button>
        <button class="menu-button">Pizza</button>
        <button class="menu-button">Us</button>
    </nav>
</header>

<style>
    :root {
        --lavender-blush: #f7ebecff;
        --thistle: #ddbdd5ff;
        --rose-quartz: #ac9fbbff;
        --space-cadet: #2b2d42ff;
        --raisin-black: #1d1e2cff;
    }
    .site-header {
        background-image: url("/public/land.svg");
        padding: 20px;
        text-align: center;
        position: relative;
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
        height: 60px; /* или сколько нужно */
        position: relative;
        z-index: 0;
    }
    .site-header h1 {
        color: #fff;
        font-size: 2rem;
        margin: 0;
    }
    .dropdown-menu {
        position: relative;
        display: flex;
        margin-top: 10px;
        gap: 62px;
        justify-content: center;
        align-items: center;
    }

    .menu-button {
        background-color: var(--rose-quartz);
        color: #4a2c2a;
        border: none;
        padding: 10px 20px;
        cursor: pointer;
        font-size: 1rem;
        position: relative;
        transition:
            background-color 0.3s ease,
            box-shadow 0.3s ease;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(248, 211, 220, 0.5);
        transition: transform 0.9s ease;
    }
    .menu-button.scared {
        background-color: var(--thistle);
        box-shadow: 0 6px 10px rgba(248, 170, 190, 0.7);
    }
</style>

<script type="module">
    const menuButtons = document.getElementsByClassName("menu-button");

    for (let i = 0; i < menuButtons.length; i++) {
        menuButtons[i].addEventListener("mouseover", () => {
            const buttonRect = menuButtons[i].getBoundingClientRect();
            const buttonWidth = buttonRect.width;
            const buttonHeight = buttonRect.height;

            const randomX = Math.random() * 200 - 100;
            const randomY = Math.random() * 200 - 100;

            let newLeft = buttonRect.left + randomX;
            let newTop = buttonRect.top + randomY;

            newLeft = Math.max(
                0,
                Math.min(newLeft, window.innerWidth - buttonWidth),
            );
            newTop = Math.max(
                0,
                Math.min(newTop, window.innerHeight - buttonHeight),
            );

            menuButtons[i].style.transform =
                `translate(${newLeft - buttonRect.left}px, ${newTop - buttonRect.top}px)`;
        });
    }
</script>
