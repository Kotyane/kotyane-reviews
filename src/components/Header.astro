<header class="site-header">
    <nav class="dropdown-menu">
        <button class="menu-button" id="menu-button">Menu</button>
        <ul class="menu-list" id="menu-list">
            <li><a href="/">Home</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/reviews">Reviews</a></li>
            <li><a href="/contact">Contact</a></li>
        </ul>
    </nav>
</header>

<style>

    :root {
            --lavender-blush: #f7ebecff;
            --thistle: #ddbdd5ff;
            --rose-quartz: #ac9fbbff;
            --space-cadet: #2b2d42ff;
            --raisin-black: #1d1e2cff;
        }
    .site-header {
        background-color: #111;
        padding: 20px;
        text-align: center;
        position: relative;
    }
    .site-header h1 {
        color: #fff;
        font-size: 2rem;
        margin: 0;
    }
    .dropdown-menu {
        position: relative;
        display: inline-block;
        margin-top: 10px;
    }
    /* New smart menu-button styles */
    .menu-button {
        background-color: var(--rose-quartz); /* нежно-розовый */
        color: #4a2c2a;
        border: none;
        padding: 10px 20px;
        cursor: pointer;
        font-size: 1rem;
        position: relative;
        transition: transform 0.3s ease, background-color 0.3s ease, box-shadow 0.3s ease;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(248, 211, 220, 0.5);
    }
    .menu-button.scared {
        background-color: var(--thistle); /* чуть темнее, испугалась */
        box-shadow: 0 6px 10px rgba(248, 170, 190, 0.7); /* резче тень */
    }
    .menu-list {
        display: none;
        background-color: #222;
        list-style: none;
        padding: 10px;
        margin: 0;
        border: 1px solid #444;
        text-align: left;
    }
    .menu-list li {
        margin: 5px 0;
    }
    .menu-list a {
        color: #fff;
        text-decoration: none;
    }
    .menu-list a:hover {
        text-decoration: underline;
    }
    .menu-list.show {
        display: block;
    }
</style>

<script client:load>
    const menuButton = document.getElementById("menu-button");
    const menuList = document.getElementById("menu-list");
    let interactionCount = 0;

    menuButton.addEventListener("mouseover", () => {
        if (interactionCount < 2) {
            // Get viewport dimensions
            const viewportWidth = window.innerWidth;
            const viewportHeight = window.innerHeight;

            // Get button dimensions
            const buttonRect = menuButton.getBoundingClientRect();
            const buttonWidth = buttonRect.width;
            const buttonHeight = buttonRect.height;

            // Define larger offsets for the first move
            const offsetMultiplier = interactionCount === 0 ? 2 : 1; // First move is farther
            let randomX = (Math.random() * 200 - 100) * offsetMultiplier;
            let randomY = (Math.random() * 200 - 100) * offsetMultiplier;

            // Calculate new position
            let newLeft = buttonRect.left + randomX;
            let newTop = buttonRect.top + randomY;

            // Constrain within viewport
            newLeft = Math.max(0, Math.min(newLeft, viewportWidth - buttonWidth));
            newTop = Math.max(0, Math.min(newTop, viewportHeight - buttonHeight));

            // Apply the new position via CSS transform
            menuButton.style.transform = `translate(${newLeft - buttonRect.left}px, ${newTop - buttonRect.top}px)`;
            interactionCount++;
            // Add 'scared' state when moving
            menuButton.classList.add('scared');
        }
    });

    menuButton.addEventListener("click", () => {
        if (interactionCount >= 2) {
            // Position the dropdown to appear right below the menu button at its last point
            const buttonRect = menuButton.getBoundingClientRect();
            menuList.style.position = "fixed";
            menuList.style.top = (buttonRect.bottom + 5) + "px"; // 5px gap below the button
            menuList.style.left = buttonRect.left + "px";
            menuList.classList.toggle("show");
            // Remove the scared state when clicked
            menuButton.classList.remove('scared');
        }
    });

    // Optional: Close the menu when clicking outside
    document.addEventListener("click", (event) => {
        if (!menuButton.contains(event.target) && !menuList.contains(event.target)) {
            menuList.classList.remove("show");
        }
    });
</script>